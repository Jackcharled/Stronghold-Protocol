    {
      "id": "account-and-dashboard",
      "name": "账号登录/MySQL/管理后台",
      "status": "custom-outside-upstream",
      "files": [
        "matchmaker/account.cjs",
        "dashboard/**",
        "public/js/ui/accountObserver.js"
      ],
      "tests": [
        "登录/注册",
        "会话恢复",
        "后台房间/账号管理"
      ]
    },
    {
      "id": "deployment",
      "name": "Nginx 多节点、PM2、一键启停、watchdog",
      "status": "custom-outside-upstream",
      "files": [
        "nginx/**",
        "ecosystem.config.cjs",
        "start-all.bat",
        "stop-all.bat",
