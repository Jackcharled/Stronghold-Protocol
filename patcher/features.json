{
  "schema": 1,
  "upstream": "sganggs/Stronghold-Protocol",
  "upstreamBase": "0.3.3",
  "customRevision": "sp-2026-10-25",
  "principles": [
    "上游文件只作为基板，不直接手改生产文件",
    "本服改动优先放入 patcher 锚点或 custom 模块",
    "每次更新先 staging，再单节点，再全量",
    "任何锚点缺失都停止，不写半套补丁"
  ],
  "layers": {
    "upstream": "官方 0.3.2/0.3.3 更新包",
    "serverPatcher": "patcher/apply.mjs，锚点插入 server/lobby.js 与 server/http/config.js",
    "clientPorts": "public/js 中本服 UI/功能移植，按文件记录在 features",
    "deployment": "matchmaker、nginx、ecosystem、dashboard、账号系统，独立于上游"
  },
