{
  "schema": 1,
  "upstream": "sganggs/Stronghold-Protocol",
  "upstreamBase": "0.3.3",
  "customRevision": "sp-2026-10-25",
  "principles": [
    "上游文件只作为基板，不直接手改生产文件",
    "本服改动优先放入 patcher 锚点或 custom 模块",
    "每次更新先 staging，再单节点，再全量",
    "任何锚点缺失都停止，不写半套补丁"
  ],
  "layers": {
    "upstream": "官方 0.3.2/0.3.3 更新包",
    "serverPatcher": "patcher/apply.mjs，锚点插入 server/lobby.js 与 server/http/config.js",
    "clientPorts": "public/js 中本服 UI/功能移植，按文件记录在 features",
    "deployment": "matchmaker、nginx、ecosystem、dashboard、账号系统，独立于上游"
  },
  "features": [
    {
      "id": "server-idle-guard",
      "name": "挂机踢人 / 同 IP 建房与 AI 上限",
      "status": "patcher",
      "files": [
        "server/lobby.js",
        "server/http/config.js"
      ],
      "tests": [
        "建房",
        "满员",
        "挂机 20 秒扫描",
        "重启恢复"
      ]
    },
    {
      "id": "server-snapshot-checkpoint",
      "name": "房间/对局快照与 Redis 检查点",
      "status": "patcher",
      "files": [
        "server/lobby.js",
        "server/match/*"
      ],
      "tests": [
        "重启恢复房间",
        "重启恢复对局",
        "本地文件丢失后从 Redis 恢复"
      ]
    },
    {
      "id": "matching-party",
      "name": "组队匹配、容量、准备、跨节点转房",
      "status": "matchmaking-server-ported",
      "files": [
        "matchmaker/**",
        "mm/client.js",
        "server/lobby.js"
      ],
      "tests": [
        "2/4/20 人容量",
        "全员准备",
        "跨节点转房",
        "断线兜底"
      ]
    },
    {
      "id": "server-player-capacity",
      "name": "5–20 人房间容量、实验选项、20 人协议",
      "status": "staging-manual",
      "files": [
        "server/lobby.js",
        "shared/playerCapacity.js",
        "shared/experimental.js",
        "shared/protocol.js",
        "public/css/screens/room.css",
        "public/js/screens/room.js"
      ],
      "tests": [
        "4 人普通房",
        "8/12/16/20 人房间",
        "第 20 个座位加入",
        "缩容拒绝已占座位",
        "room.setExperimental",
        "5–20 人房座位保持 4 人尺寸",
        "超出部分横向滚动可查看全部座位"
      ]
    },
    {
      "id": "client-announcement",
      "name": "公告弹窗 + 官方Q群入口（标题/大厅/同盟房间）",
      "status": "ported-main",
      "files": [
        "matchmaker/public/client.js",
        "mm/client.js"
      ],
      "tests": [
        "新公告自动打开",
        "已读后黄点消失",
        "刷新不重复弹出",
        "标题屏左下角、添加到桌面按钮上方显示官方Q群按钮",
        "大厅与同盟房间顶栏显示Q群入口"
      ]
    },
    {
      "id": "client-watch",
